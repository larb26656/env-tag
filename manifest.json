{
  "name": "ENV tag",
  "description": "A simple Chrome extension that adds a visual indicator (ribbon)",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "js": ["src/scripts/content.jsx"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "tabs"]
}
